# ============================================================
#  AI Document Assistant - Environment Configuration (EXAMPLE)
# ------------------------------------------------------------
#  Copy this file to `.env` and fill in the values.
#  NEVER commit your real `.env` file (it is git-ignored).
# ============================================================

# ---- Groq LLM (required) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# ---- Database ----
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ---- Auth (Google OAuth + JWT) ----
# Google OAuth client id (safe to expose to the frontend). Configure your app's
# origin (e.g. http://localhost:3000) as an Authorized JavaScript origin in the
# Google Cloud console for this client.
GOOGLE_CLIENT_ID=319420188294-b74l9ah7q95naq3p45bd4sqqltm6931k.apps.googleusercontent.com
# Secret for signing app JWTs. MUST be a long random value and kept secret.
JWT_SECRET_KEY=

# ---- LLM model (configurable) ----
# See https://console.groq.com/docs/models for currently supported models.
# Example current model: openai/gpt-oss-20b (older llama-3.x Groq models are deprecated).
GROQ_MODEL=

# ---- Gemini (automatic fallback LLM) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 'gemini-flash-latest' tracks the current stable flash model. Pinned names like
# gemini-2.5-flash may be unavailable to new keys; run models.list() to check.
GEMINI_MODEL=gemini-flash-latest

# ---- LLM routing ----
# Primary provider is tried first; fallback is used only on transient provider
# failures (rate limit / timeout / temporary 5xx). Set ENABLE_LLM_FALLBACK=false
# to disable fallback entirely.
PRIMARY_LLM=groq
FALLBACK_LLM=gemini
ENABLE_LLM_FALLBACK=true

# ---- Embeddings (configurable provider/model) ----
# Provider is fixed to a local embedding model by default (no extra API key needed).
EMBEDDING_MODEL=

# ---- Chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Retrieval ----
TOP_K=5
# NOTE: 0.75 is only an EXAMPLE. The correct value depends on your embedding
# model and must be tuned against real evaluation questions. For the default
# local model (BAAI/bge-small-en-v1.5) a value around 0.45-0.60 works well.
SIMILARITY_THRESHOLD=0.75

# ---- Uploads ----
MAX_FILE_SIZE_MB=20

# ---- CORS (comma separated list of allowed origins) ----
CORS_ORIGINS=http://localhost:3000
