# Base URL of the backend API. Leave empty to use the Vite dev proxy (/api -> :8000).
# For Docker/production set this to the public backend URL, e.g. http://localhost:8000
VITE_API_BASE_URL=

# Google OAuth client id (public). Optional here: the app falls back to the
# configured client id, but you can override it at build time.
VITE_GOOGLE_CLIENT_ID=
