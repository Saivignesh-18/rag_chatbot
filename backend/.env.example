# Backend-local example env. In normal use the project-root .env is loaded.
# See ../.env.example for the full documented list.
GROQ_API_KEY=
DATABASE_URL=postgresql+psycopg2://raguser:ragpassword@localhost:5433/ragdb
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SIMILARITY_THRESHOLD=0.5
MAX_FILE_SIZE_MB=20
CORS_ORIGINS=http://localhost:3000
